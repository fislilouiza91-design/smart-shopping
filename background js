// background.js — Service Worker

const API_URL = 'https://stellar-pithivier-10424a.netlify.app/.netlify/functions/compare';

chrome.runtime.onMessage.addListener((message, sender, sendResponse) => {
  if (message.action === 'compare') {
    handleCompare(message.payload)
      .then(data => sendResponse({ success: true, data }))
      .catch(err => sendResponse({ success: false, error: err.message }));
    return true; // async
  }
});

async function handleCompare(product) {
  const response = await fetch(API_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ url: product.url, title: product.title })
  });

  if (!response.ok) {
    throw new Error('Server error: ' + response.status);
  }

  return await response.json();
}
